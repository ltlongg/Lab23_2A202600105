# Optional for real LangGraph persistence. The starter uses memory/mock by default.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/langgraph_lab
CHECKPOINTER=memory
LOG_LEVEL=INFO

# OpenAI compatible LLM settings
OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL_NAME=gpt-3.5-turbo

